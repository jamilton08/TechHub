# Copy to /opt/hsct/deploy/.env on the server and fill in. Never commit the real file.

# Django
DJANGO_SECRET_KEY=            # openssl rand -base64 48
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.hsct.tech
FRONTEND_ORIGINS=https://hsct.tech,https://lessons.hsct.tech
COOKIE_DOMAIN=.hsct.tech      # so hsct.tech (the site) can read the csrftoken cookie set by api.hsct.tech

# Postgres (the compose file wires DATABASE_URL from this)
POSTGRES_PASSWORD=            # openssl rand -hex 24

# Lesson files in Cloudflare R2 (bucket "hsct-lessons", custom domain lessons.hsct.tech)
R2_BUCKET=hsct-lessons
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LESSON_FILES_BASE=https://lessons.hsct.tech

# Cloudflare Tunnel "hsct" (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
